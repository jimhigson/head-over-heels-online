<section>
  <h2 class="mb-3 text-pastelBlue">Articles</h2>
  <ul class="flex flex-col gap-3">
    {%- for article in collections.article | reverse %}
      <li>
        <a href="{{ article.url }}" class="site-link text-pastelBlue text-lg no-underline">
          {{ article.data.title }}
        </a>
        <p class="text-midGrey">
          {{ article.date | date }} &mdash; {{ article.data.summary }}
        </p>
      </li>
    {%- endfor %}
  </ul>
</section>
