{
  "name": "hohjs",
  "private": true,
  "version": "25.0.0",
  "sideEffects": [
    "*.css",
    "src/main.tsx",
    "src/editor/main.tsx",
    "src/game/gameMain.ts",
    "src/game/components/App.tsx",
    "src/store/store.ts",
    "src/editor/JsonRoomEditor/monaco-loader.ts",
    "src/game/mainLoop/frameTiming/FrameTimingStats.ts",
    "src/game/render/filters/lutTexture/stdLuts/paletteQuantisationLut.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jimhigson/head-over-heels-online"
  },
  "homepage": "https://blockstack.ing",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev:game": "node --max_http_header_size=128000 node_modules/vite/bin/vite",
    "dev:editor": "vite --config vite.editor.config.ts --mode development",
    "preview:game": "vite preview",
    "preview:editor": "vite --config vite.editor.config.ts preview",
    "build:game": "vite build",
    "build:editor": "vite build --config vite.editor.config.ts --emptyOutDir",
    "clean:ci": "rm -rf dist node_modules",
    "build": "pnpm run \"/^build:(game|editor)$/\"",
    "//check:build": "I don't know any way to check the build will pass other than running it:",
    "check:build:game": "pnpm build:game",
    "check:build:editor": "pnpm build:editor",
    "watch:type": "tsc --noEmit --watch --project ./tsconfig.app.json",
    "check:type": "tsc --noEmit --project ./tsconfig.app.json",
    "check:type:e2e": "tsc --noEmit --project ./e2e/tsconfig.json",
    "check:type:scripts": "tsc --noEmit --project ./scripts/tsconfig.json",
    "tsgo": "tsgo --noEmit --project ./tsconfig.app.json",
    "check:lint": "oxlint",
    "check": "COLOR=1 pnpm run \"/^check:.*/\"",
    "fix": "COLOR=1 pnpm run \"/^fix:.*/\"",
    "fix:lint": "oxlint --fix",
    "check:format": "prettier . --check",
    "fix:format": "prettier . --write",
    "check:test": "vitest run",
    "watch:test": "vitest watch",
    "bench": "pnpm vitest bench",
    "build-and-playwright": "pnpm build:game && playwright test",
    "visual-regression-summary": "./scripts/visualRegressionSummary.ts",
    "gen:rooms": "tsx scripts/campaignXml2Json/scripts/genRooms.ts && (oxlint --fix --no-ignore src/_generated/originalCampaign || true) && prettier src/_generated/originalCampaign --write && oxlint --no-ignore src/_generated/originalCampaign",
    "gen:roomsPatch": "tsx scripts/campaignXml2Json/scripts/genRoomsPatch.ts && prettier src/_generated/originalCampaign/patches/*.json --write",
    "predeploy": "pnpm run check && pnpm run build && echo blockstack.ing > dist/CNAME && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist",
    "deploy:r2": "tsx scripts/deployToR2.ts",
    "toppySpritesheet": "tsx scripts/toppySpritesheet.ts",
    "gen:font": "tsx scripts/genFont.ts",
    "iff2png": "./scripts/iff2png.sh",
    "watch:iff2png": "pnpm run iff2png && chokidar gfx/sprites.iff -c \"pnpm run iff2png\"",
    "check:circDep": "dpdm -T --exit-code circular:1 src/main.tsx",
    "gen:types": "./scripts/itemTypesFromTs.ts src/model/ItemInPlay.ts ItemInPlayType | sh scripts/oxlintFixStdin.sh src/_generated/types/ItemInPlayUnion.ts | prettier --parser typescript > src/_generated/types/ItemInPlayUnion.ts",
    "gen:roomSchema:ts": "./scripts/schema/flattenType.ts --file src/model/RoomJson.ts --type AnyRoomJson --output-type RoomJsonSchema | sh scripts/oxlintFixStdin.sh src/_generated/Room.flat.d.ts | prettier --parser typescript > src/_generated/Room.flat.d.ts",
    "gen:roomSchema:json": "ts-json-schema-generator --path src/_generated/Room.flat.d.ts --type RoomJsonSchema | scripts/schema/postProcessSchema.ts | prettier --parser json > src/_generated/room.schema.json",
    "gen:roomSchema:dedup": "scripts/schema/deduplicateSchema.ts src/_generated/room.schema.json src/_generated/room.schema.json",
    "gen:roomSchema": "pnpm gen:roomSchema:ts; pnpm gen:roomSchema:json; pnpm gen:roomSchema:dedup && prettier --write src/_generated/room.schema.json",
    "gen:dbTypes": "supabase gen types typescript --project-id pkswdnpftrundnewgnya | sh scripts/oxlintFixStdin.sh src/_generated/db.d.ts | prettier --parser typescript > src/_generated/db.d.ts",
    "dumpDb:schema": "pg_dump-17 -h aws-0-eu-west-2.pooler.supabase.com -p 6543 -d postgres -U postgres.pkswdnpftrundnewgnya --schema-only --schema=public --no-owner --no-privileges > db/schema.sql",
    "dumpDb:data": "pg_dump-17 -h aws-0-eu-west-2.pooler.supabase.com -p 6543 -d postgres -U postgres.pkswdnpftrundnewgnya --data-only --schema=public --no-owner --no-privileges > db/data.sql",
    "gen:seed": "tsx scripts/genSeed.ts",
    "test:db": "supabase test db",
    "prepare": "husky"
  },
  "dependencies": {
    "@blockstacking/jims-shaders": "^0.4.5",
    "@floating-ui/react": "^0.27.19",
    "@github/mini-throttle": "^2.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/openapi-types": "^27.0.0",
    "@preact/preset-vite": "^2.10.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/plugin-global-shortcut": "~2.3.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@types/nano-equal": "^2.0.2",
    "@types/natural-compare-lite": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260601.1",
    "clsx": "^2.1.1",
    "eslint-plugin-perfectionist": "^4.15.0",
    "husky": "^9.1.7",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "nano-equal": "^2.0.2",
    "natural-compare-lite": "^1.4.0",
    "natural-orderby": "^5.0.0",
    "pixi.js": "8.16.0",
    "preact": "11.0.0-beta.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^3.0.3",
    "redux-persist": "^6.0.0",
    "snarkdown-in-react": "^2.0.3",
    "string-transform": "^21.9.19",
    "tailwind-merge": "^2.6.0",
    "tailwind-scrollbar": "^3.1.0",
    "timeago.js": "^4.0.2",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@byteland/ink-scroll-bar": "^1.0.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@cwasm/webp": "^0.1.5",
    "@playwright/test": "^1.57.0",
    "@supabase/postgrest-js": "2.93.1",
    "@supabase/supabase-js": "^2.93.1",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/cli": "^2.9.6",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@types/node": "^25.3.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/seedrandom": "^3.0.8",
    "@types/umami": "^2.10.0",
    "ajv": "^8.17.1",
    "chalk": "^5.4.1",
    "chokidar-cli": "^3.0.0",
    "commander": "^14.0.0",
    "dougmencken_HeadOverHeels": "github:dougmencken/HeadOverHeels#08aee0cb050405dc23d95bf288631452bec28c9f",
    "dpdm": "^3.14.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "execa": "^9.6.1",
    "fast-json-patch": "^3.1.1",
    "fullscreen-ink": "^0.1.0",
    "get-port": "^7.2.0",
    "gh-pages": "^6.3.0",
    "git-format-staged": "^3.1.1",
    "image-size": "^1.2.0",
    "immer": "^11.1.8",
    "ink": "^7.0.0",
    "ink-scroll-list": "^0.4.1",
    "js-base64": "^3.7.7",
    "json-canonicalize": "^1.0.6",
    "jsonc-parser": "^3.3.1",
    "kill-port": "^2.0.1",
    "knip": "^6.14.1",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "normalize-wheel-es": "^1.2.0",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.68.0",
    "oxlint-plugin-eslint": "^1.68.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "3.4.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "seedrandom": "^3.0.5",
    "sharp": "^0.35.0",
    "supabase": "^2.107.0",
    "tailwindcss": "^3.4.17",
    "ts-json-schema-generator": "^2.4.0",
    "ts-morph": "^25.0.1",
    "tsx": "^4.19.3",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.13",
    "vite-plugin-glsl": "^1.6.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "wawoff2": "^2.0.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.100.0",
    "xml-js": "^1.6.11"
  },
  "engines": {
    "node": ">=25.6.1"
  },
  "packageManager": "pnpm@11.5.1"
}